{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simutrans Factory Graph",
  "version": "0.1.0",
  "identifier": "org.simutrans-tools.factory-graph",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Simutrans Factory Graph",
        "width": 1240,
        "height": 820,
        "minWidth": 850,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "shortDescription": "Simutrans 産業・貨物チェーン探索"
  }
}
